---
/**
 * CRT-VR · Act 7 · "hexa-emission" — Hexa-Index, part 1: the signal.
 *
 * Each Focus-Well rim carries an index strip of MgO or doped diamond on top of
 * the biased Kurocoat (coordinator-approved, Nov 27). When the beam brushes the
 * strip it makes no light (the rim is black) but kicks off secondary electrons:
 * both materials have a secondary-electron yield above 1, so one primary in
 * gives several out. That burst is the position signal Hexa-Index reads.
 *
 * Top: magnified section of one rim between two triangles. Bottom: the rim
 * current against beam position, like a scope trace.
 *
 * Tiers: full (auto raster pass + particles + glow), reduced (auto pass, fewer
 * particles), static (beam parked on the strip, burst drawn as a still).
 */
import '../../visuals/crt-vr/tokens.css';
import './blueprint.css';
import type { VfxSlotProps } from '../../../lib/motion/types';

interface Props extends Partial<VfxSlotProps> { id?: string }
const { tier = 'full', id = 'bp-emission' } = Astro.props;

const FLOOR = 270, TOP = 110, RX0 = 410, RX1 = 490;
// static burst: fixed spray of secondaries
const still = Array.from({ length: 22 }, (_, i) => {
  const a = (-160 + (i * 140) / 21) * (Math.PI / 180);
  const r = 40 + ((i * 37) % 90);
  return { x: 450 + Math.cos(a) * r * 1.3, y: TOP - 6 + Math.sin(a) * r };
});
---

<div class:list={['crtvr', 'bp', 'bp-emission', { 'is-static': tier === 'static' }]} id={id} data-hexa-emission>
  <div class="bp-frame bp-wide">
    <div class="bp-head">
      <span><b>Hexa-Index · emission</b> &nbsp;· the rim that talks back</span>
      <span class="bp-dwg">DWG CRT-VR-07-06A · magnified rim section</span>
    </div>

    <svg viewBox="0 0 900 470" role="img" aria-labelledby={`${id}-t`}>
      <title id={`${id}-t`}>The beam brushes the index strip on a well rim and secondary electrons fly off; the rim current pulses as the beam crosses it</title>
      <defs>
        <pattern id={`${id}-kuro`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <rect width="7" height="7" fill="#05070b" />
          <line x1="0" y1="0" x2="0" y2="7" stroke="#7fd4ff" stroke-opacity=".2" />
        </pattern>
        <linearGradient id={`${id}-fade`} x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="#00ff99" stop-opacity=".0" />
          <stop offset="1" stop-color="#00ff99" stop-opacity=".35" />
        </linearGradient>
      </defs>

      <!-- floors: two triangles either side of the rim -->
      <rect x="40" y={FLOOR} width={RX0 - 40} height="18" fill="#ff3c3c" opacity=".55" />
      <rect x={RX1} y={FLOOR} width={860 - RX1} height="18" fill="#00ff99" opacity=".55" />
      <rect x="40" y={FLOOR + 18} width="820" height="16" fill="#7fd4ff" opacity=".1" />
      <ellipse data-glowfloor cx="450" cy={FLOOR + 30} rx="70" ry="16" fill="#00ff99" opacity="0" class="floorglow" />

      <!-- the rim: Kurocoat body, index strip on top -->
      <rect x={RX0} y={TOP} width={RX1 - RX0} height={FLOOR - TOP + 18} fill={`url(#${id}-kuro)`} stroke="#7fd4ff" stroke-opacity=".6" />
      <rect data-strip x={RX0} y={TOP - 12} width={RX1 - RX0} height="12" fill="#e8f0ff" />
      <text class="lbl sub" x={RX1 + 12} y={TOP - 2} data-matlbl fill="#e8f0ff">MgO index strip</text>
      <text class="lbl sub" x={RX1 + 12} y={TOP + 40}>Kurocoat rim (biased −)</text>
      <text class="lbl sub" x="56" y={FLOOR + 56}>R triangle</text>
      <text class="lbl sub" x="784" y={FLOOR + 56}>G triangle</text>

      <!-- collector direction -->
      <path class="ink dim dash" d="M520,40 L860,40" />
      <path class="ink dim" d="M850,34 L860,40 L850,46" />
      <text class="lbl sub" x="560" y="30">to the collector ring (Hexa-Index sensors)</text>

      <!-- beam -->
      <g data-beam>
        <path data-beampath class="beam glow" d="" />
        <ellipse data-beamspot rx="18" ry="5" class="spot glow" />
      </g>
      <!-- light from the floor where the beam lands on phosphor -->
      <g data-photons></g>
      <!-- secondaries -->
      <g data-se>
        {still.map((p) => <circle class="se still" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="2.4" />)}
      </g>

      <!-- scope -->
      <g transform="translate(40 340)">
        <rect width="820" height="110" fill="#020610" stroke="#7fd4ff" stroke-opacity=".35" />
        {[1, 2, 3, 4, 5, 6, 7].map((i) => <line x1={i * 102.5} y1="0" x2={i * 102.5} y2="110" stroke="#7fd4ff" stroke-opacity=".08" />)}
        <line x1="0" y1="90" x2="820" y2="90" stroke="#7fd4ff" stroke-opacity=".25" />
        <path data-trace class="trace" d="" />
        <path data-live class="live glow" d="" />
        <line data-cursor x1="0" y1="0" x2="0" y2="110" stroke="#ffe135" stroke-opacity=".7" />
        <text class="lbl sub" x="8" y="16">rim current</text>
        <text class="lbl sub" x="812" y="104" text-anchor="end">beam position across the rim →</text>
      </g>
    </svg>

    <div class="bp-controls">
      <label class="bp-ctl">Beam position <output data-o="pos"></output>
        <input type="range" min="60" max="840" value="450" data-in="pos" />
      </label>
      <div class="bp-ctl">Index strip
        <span class="bp-seg" role="group" aria-label="Index strip material">
          <button type="button" aria-pressed="true" data-mat="mgo">MgO</button>
          <button type="button" aria-pressed="false" data-mat="diamond">Doped diamond</button>
        </span>
      </div>
      <div class="bp-ctl">Raster pass
        <span class="bp-seg"><button type="button" aria-pressed="true" data-auto>Auto</button></span>
      </div>
    </div>
    <div class="bp-readouts">
      <div class="bp-ro" data-ro="land"><span>Beam is landing on</span><strong>—</strong></div>
      <div class="bp-ro" data-ro="out"><span>Light out</span><strong>—</strong></div>
      <div class="bp-ro" data-ro="se"><span>Secondary electrons</span><strong>—</strong></div>
    </div>
    <p class="bp-foot">Both strip materials have a secondary-electron yield above 1, so a brush of the rim makes a clean current pulse with no light. Doped diamond with a negative-electron-affinity surface yields more than MgO. The Kurocoat underneath keeps the rim black either way.</p>
  </div>
</div>

<script>
  import { onTier, type VfxTier } from '../../visuals/crt-vr/lib/tier';

  const FLOOR = 270, TOP = 110, RX0 = 410, RX1 = 490, BEAM_R = 18;
  const NS = 'http://www.w3.org/2000/svg';
  const ANG = (38 * Math.PI) / 180;

  /** Fraction of the beam spot overlapping the strip (0..1). */
  const overlap = (x: number) => {
    const a = Math.max(x - BEAM_R, RX0), b = Math.min(x + BEAM_R, RX1);
    return Math.max(0, b - a) / (2 * BEAM_R);
  };

  function setup(root: HTMLElement) {
    const q = <T extends Element>(s: string) => root.querySelector(s) as T;
    const pos = q<HTMLInputElement>('[data-in="pos"]');
    const posOut = q<HTMLOutputElement>('[data-o="pos"]');
    const beamPath = q<SVGPathElement>('[data-beampath]');
    const spot = q<SVGEllipseElement>('[data-beamspot]');
    const seG = q<SVGGElement>('[data-se]');
    const photons = q<SVGGElement>('[data-photons]');
    const glowFloor = q<SVGEllipseElement>('[data-glowfloor]');
    const strip = q<SVGRectElement>('[data-strip]');
    const trace = q<SVGPathElement>('[data-trace]');
    const live = q<SVGPathElement>('[data-live]');
    const cursor = q<SVGLineElement>('[data-cursor]');
    const autoBtn = q<HTMLButtonElement>('[data-auto]');
    const matBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-mat]'));
    const ro = (k: string) => q<HTMLElement>(`[data-ro="${k}"] strong`);
    let tier: VfxTier = 'full';
    let mat: 'mgo' | 'diamond' = 'mgo';
    let auto = true, visible = false, raf = 0, last = 0;
    let x = 450;
    const hist: number[] = [];

    type P = { el: SVGCircleElement; x: number; y: number; vx: number; vy: number; life: number };
    const pool: P[] = [];
    for (let i = 0; i < 90; i++) {
      const el = document.createElementNS(NS, 'circle');
      el.setAttribute('r', '2.2');
      el.setAttribute('class', 'se');
      el.style.opacity = '0';
      seG.appendChild(el);
      pool.push({ el, x: 0, y: 0, vx: 0, vy: 0, life: 0 });
    }
    const yieldK = () => (mat === 'diamond' ? 1.6 : 1);

    const drawTrace = () => {
      let d = '';
      for (let px = 0; px <= 820; px += 4) {
        const v = overlap(px + 40) * yieldK();
        d += `${px === 0 ? 'M' : 'L'}${px},${(90 - v * 52).toFixed(1)}`;
      }
      trace.setAttribute('d', d);
    };

    const place = () => {
      const ov = overlap(x);
      const onStrip = ov > 0;
      const inWall = x > RX0 && x < RX1;
      const ly = onStrip || inWall ? TOP - 12 : FLOOR;
      const sx = x - Math.cos(ANG) * 600, sy = ly - Math.sin(ANG) * 600;
      beamPath.setAttribute('d', `M${sx.toFixed(1)},${sy.toFixed(1)} L${x.toFixed(1)},${ly}`);
      spot.setAttribute('cx', x.toFixed(1));
      spot.setAttribute('cy', String(ly));
      const light = !inWall && ov < 0.999 ? 1 - ov : 0;
      glowFloor.setAttribute('opacity', String(0.55 * light));
      glowFloor.setAttribute('cx', String(x));
      glowFloor.setAttribute('fill', x < RX0 ? '#ff3c3c' : '#00ff99');
      strip.style.fill = ov > 0 ? '#ffffff' : '#e8f0ff';
      strip.classList.toggle('glow', ov > 0);
      const sig = ov * yieldK();
      cursor.setAttribute('x1', String(x - 40));
      cursor.setAttribute('x2', String(x - 40));
      ro('land').textContent = ov > 0.6 ? 'Index strip' : ov > 0 ? 'Strip edge + phosphor' : 'Phosphor';
      ro('out').innerHTML = light > 0.05 ? `${Math.round(light * 100)}<small>%</small>` : `0<small>% · rim stays black</small>`;
      ro('se').innerHTML = sig > 0 ? `δ &gt; 1<small>${mat === 'diamond' ? 'diamond burst' : 'MgO burst'}</small>` : `none<small></small>`;
      posOut.textContent = `${((x - 450) / 100).toFixed(2)} µm from rim centre`;
      if (hist.length && Math.abs(hist[hist.length - 1] - x) > 120) hist.length = 0;
      hist.push(x);
      if (hist.length > 30) hist.shift();
      live.setAttribute('d', hist.map((h, i) => `${i ? 'L' : 'M'}${(h - 40).toFixed(1)},${(90 - overlap(h) * yieldK() * 52).toFixed(1)}`).join(''));
      return sig;
    };

    const frame = (t: number) => {
      raf = 0;
      const dt = Math.min(0.05, (t - (last || t)) / 1000);
      last = t;
      if (auto && tier !== 'static') {
        const ph = (t / 2600) % 1;
        x = 60 + 780 * ph;
        pos.value = String(Math.round(x));
      }
      const sig = place();
      if (tier !== 'static') {
        const rate = tier === 'full' ? 2.2 : 0.8;
        let spawn = sig * rate;
        for (const p of pool) {
          if (p.life <= 0 && spawn > Math.random()) {
            spawn -= 1;
            const a = -Math.PI / 2 + (Math.random() - 0.35) * 2.2;
            const v = 120 + Math.random() * 160;
            p.x = x + (Math.random() - 0.5) * 20; p.y = TOP - 12;
            p.vx = Math.cos(a) * v; p.vy = Math.sin(a) * v; p.life = 1;
          }
          if (p.life > 0) {
            p.vx += 140 * dt; // drift toward the collector
            p.x += p.vx * dt; p.y += p.vy * dt; p.life -= dt * 0.9;
            p.el.setAttribute('cx', p.x.toFixed(1)); p.el.setAttribute('cy', p.y.toFixed(1));
            p.el.style.opacity = String(Math.max(0, p.life));
            if (p.y < 0 || p.x > 900) p.life = 0;
          } else p.el.style.opacity = '0';
        }
        // photons rising from the floor (full tier only)
        if (tier === 'full' && photons.childElementCount < 18 && Math.random() < 0.5 && overlap(x) < 1 && !(x > RX0 && x < RX1)) {
          const ph = document.createElementNS(NS, 'line');
          const px = x + (Math.random() - 0.5) * 30;
          ph.setAttribute('x1', String(px)); ph.setAttribute('x2', String(px));
          ph.setAttribute('y1', String(FLOOR + 30)); ph.setAttribute('y2', String(FLOOR + 40));
          ph.setAttribute('class', 'photon');
          photons.appendChild(ph);
          setTimeout(() => ph.remove(), 600);
        }
      }
      if (visible && tier !== 'static') raf = requestAnimationFrame(frame);
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(frame); };

    pos.addEventListener('input', () => { setAuto(false); x = Number(pos.value); kick(); });
    const setAuto = (on: boolean) => { auto = on; autoBtn.setAttribute('aria-pressed', String(on)); autoBtn.textContent = on ? 'Auto' : 'Paused'; kick(); };
    autoBtn.addEventListener('click', () => setAuto(!auto));
    matBtns.forEach((b) => b.addEventListener('click', () => {
      mat = b.dataset.mat as 'mgo' | 'diamond';
      matBtns.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      q<SVGTextElement>('[data-matlbl]').textContent = mat === 'diamond' ? 'Doped-diamond index strip' : 'MgO index strip';
      drawTrace(); kick();
    }));

    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) kick(); }).observe(root);
    onTier((t) => {
      tier = t;
      root.classList.toggle('is-static', t === 'static');
      if (t === 'static') { setAuto(false); x = 440; pos.value = '440'; pool.forEach((p) => { p.life = 0; p.el.style.opacity = '0'; }); }
      drawTrace(); kick();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-hexa-emission]').forEach(setup);
</script>

<style>
  .beam { fill: none; stroke: #00ff99; stroke-width: 6; stroke-opacity: .55; color: #00ff99; }
  .spot { fill: #eafff4; color: #00ff99; }
  [data-se] :global(.se) { fill: #9fd8ff; }
  [data-se] :global(.se.still) { display: none; }
  .is-static [data-se] :global(.se.still) { display: inline; }
  [data-photons] :global(.photon) { stroke: #00ff99; stroke-width: 2; animation: bp-photon .6s linear forwards; }
  @keyframes bp-photon { to { transform: translateY(60px); opacity: 0; } }
  .floorglow { filter: blur(8px); }
  .trace { fill: none; stroke: #7fd4ff; stroke-opacity: .35; stroke-width: 1.4; }
  .live { fill: none; stroke: #ffe135; stroke-width: 2; color: #ffe135; }
</style>
