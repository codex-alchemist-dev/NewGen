---
/**
 * CRT-VR · Act 6 · "Judder-free" — slot `motion-blur-compare`.
 *
 * The same moving target on two displays, drawn as your eye sees it while it
 * follows the target (a pursuit view). Sample-and-hold keeps each frame lit for
 * the whole frame, so the image smears across your retina by speed × hold time.
 * CRT-VR flashes each line for an instant and lets it fade, so the target stays
 * crisp at any speed. Illustrative: the hold time is a typical full-persistence
 * VR frame and the speed is in screen widths per second.
 *
 * Tiers: full (smooth motion), reduced (same, fewer smear samples), static
 * (target parked mid-lane, smeared vs. crisp).
 */
import '../../visuals/crt-vr/tokens.css';
import './ix.css';
import type { VfxSlotProps } from '../../../lib/motion/types';

interface Props extends Partial<VfxSlotProps> { id?: string }
const { id = 'crtvr-motion-blur' } = Astro.props;
---
<div class="crtvr ix mbc" id={id} data-mbc>
  <div class="ix-head">
    <span class="ix-tag">What your eye sees, following the target</span>
    <span class="ix-note">Illustrative pursuit view</span>
  </div>
  <div class="ix-frame mbc-frame">
    <div class="mbc-lane" style="--ix-accent: var(--crtvr-panel-cold)">
      <span class="mbc-name"><span class="ix-label">Sample-and-hold</span><em>Smears</em></span>
      <canvas data-lane="hold" aria-hidden="true"></canvas>
    </div>
    <div class="mbc-lane">
      <span class="mbc-name"><span class="ix-label mbc-hot">CRT-VR impulse</span><em class="hot">Stays crisp</em></span>
      <canvas data-lane="impulse" aria-hidden="true"></canvas>
    </div>
  </div>
  <p class="ix-sr">A target moving across two displays. On the sample-and-hold display it smears into a blur as it moves. On CRT-VR, which flashes each line for an instant, it stays sharp at any speed.</p>
  <div class="ix-controls">
    <label class="ix-range"><span class="ix-label">Speed</span>
      <input type="range" min="0.4" max="2" step="0.05" value="1" data-speed aria-label="Target speed" />
    </label>
    <button type="button" class="ix-chip" aria-pressed="false" data-pause>Pause</button>
  </div>
</div>

<style>
  .mbc-frame { display: grid; }
  .mbc-lane { position: relative; border-bottom: 1px solid var(--crtvr-line); }
  .mbc-lane:last-child { border-bottom: 0; }
  .mbc-lane canvas { width: 100%; height: clamp(130px, 18vw, 200px); display: block; }
  .mbc-name { position: absolute; left: 16px; top: 12px; z-index: 2; display: grid; gap: 0; pointer-events: none; }
  .mbc-name em { font-family: var(--crtvr-font-serif); font-style: italic; font-weight: 300; font-size: 20px; color: var(--crtvr-panel-cold); }
  .mbc-name em.hot { color: var(--crtvr-phosphor); }
  .mbc-hot { color: var(--crtvr-white); }
</style>

<script>
  import { onTier, type VfxTier } from '../../visuals/crt-vr/lib/tier';
  import { widen, rafLoop, fitCanvas } from './lib/wide';

  const HOLD = 1 / 90;   // full-persistence frame (s)
  const FLASH = 0.0004;  // impulse: lit for a tiny fraction of the frame
  const RATE = 0.75;     // lane crossings per second at speed 1

  function makeTarget(): HTMLCanvasElement {
    const c = document.createElement('canvas'); c.width = 300; c.height = 180;
    const g = c.getContext('2d')!;
    g.fillStyle = '#04050a'; g.fillRect(0, 0, 300, 180);
    // checker strip
    for (let i = 0; i < 12; i++) { g.fillStyle = i % 2 ? '#f0f4ff' : '#04050a'; g.fillRect(20 + i * 22, 20, 22, 22); }
    g.strokeStyle = '#00ff99'; g.lineWidth = 3; g.strokeRect(20, 20, 264, 140);
    g.font = '64px "Bebas Neue", Impact, sans-serif'; g.fillStyle = '#f0f4ff'; g.textAlign = 'left'; g.textBaseline = 'alphabetic';
    g.fillText('CRT-VR', 36, 118);
    g.beginPath(); g.arc(240, 98, 26, 0, Math.PI * 2); g.fillStyle = '#ff3c6e'; g.fill();
    g.fillStyle = '#04050a'; g.beginPath(); g.arc(240, 98, 10, 0, Math.PI * 2); g.fill();
    g.font = '15px "DM Mono", monospace'; g.fillStyle = '#00ff99'; g.fillText('NEWGEN × SONY', 36, 145);
    return c;
  }

  function init(root: HTMLElement) {
    widen(root);
    let target = makeTarget();
    document.fonts?.ready.then(() => { target = makeTarget(); });
    const lanes = Array.from(root.querySelectorAll<HTMLCanvasElement>('canvas'));
    const speedIn = root.querySelector<HTMLInputElement>('[data-speed]')!;
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    let tier: VfxTier = 'full';
    let pos = 0.5; // 0..1 across the lane
    let paused = false;

    const paint = () => {
      lanes.forEach((c) => {
        const { w, h } = fitCanvas(c);
        const g = c.getContext('2d')!;
        g.fillStyle = '#04050a'; g.fillRect(0, 0, w, h);
        // static reference grid
        g.strokeStyle = 'rgba(26,34,64,.9)'; g.lineWidth = 1;
        for (let x = 0; x < w; x += h / 4) { g.beginPath(); g.moveTo(x, 0); g.lineTo(x, h); g.stroke(); }
        const th = h * 0.62, tw = th * (300 / 180);
        const cx = -tw / 2 + pos * (w + tw), cy = (h - th) / 2 + h * 0.06;
        const v = (+speedIn.value) * RATE * (w + tw); // px per second, matches the motion
        const hold = c.dataset.lane === 'hold' ? HOLD : FLASH;
        const smear = paused ? 0 : v * hold;
        const n = smear < 1 ? 1 : Math.min(tier === 'full' ? 40 : 16, Math.ceil(smear / 1.5));
        g.globalCompositeOperation = 'lighter';
        g.globalAlpha = 1 / n;
        for (let k = 0; k < n; k++) {
          const off = n === 1 ? 0 : (k / (n - 1) - 0.5) * smear;
          g.drawImage(target, cx - tw / 2 + off, cy, tw, th);
        }
        g.globalAlpha = 1; g.globalCompositeOperation = 'source-over';
      });
    };

    const loop = rafLoop(root, (dt) => {
      if (!paused) pos = (pos + dt * (+speedIn.value) * RATE) % 1;
      paint();
    });

    speedIn.addEventListener('input', () => { if (tier === 'static') paint(); });
    pauseBtn.addEventListener('click', () => {
      paused = !paused; pauseBtn.setAttribute('aria-pressed', String(paused)); pauseBtn.textContent = paused ? 'Play' : 'Pause'; paint();
    });
    window.addEventListener('resize', () => paint());
    onTier((t) => {
      tier = t;
      loop.enabled = t !== 'static';
      if (t === 'static') { pos = 0.5; paint(); }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-mbc]').forEach(init);
</script>
