---
/**
 * CRT-VR · Act 6 · "The motion crown" — slot `motion-lineage-chart`.
 *
 * Motion clarity across the eras, qualitative. A time cursor sweeps from the
 * 1950s to today as you scroll and draws each technology up to it: CRT owns the
 * top for decades (dashed once only the holdouts keep it), LCD never catches up,
 * OLED chases with black-frame tricks and 480 Hz races, and CRT-VR breaks off
 * the top of the chart. Curve shapes are illustrative; there are no units.
 *
 * Tiers: full (glow + flare), reduced (no filters), static (fully drawn).
 */
import '../../visuals/crt-vr/tokens.css';
import './cx.css';
import type { VfxSlotProps } from '../../../lib/motion/types';

interface Props extends Partial<VfxSlotProps> { id?: string }
const { id = 'crtvr-motion-lineage' } = Astro.props;

const X0 = 90, X1 = 930, Y0 = 400, Y1 = 70; // plot box
const Y_MIN = 1950, Y_MAX = 2032;
const x = (yr: number) => X0 + ((yr - Y_MIN) / (Y_MAX - Y_MIN)) * (X1 - X0);
const y = (v: number) => Y0 - v * (Y0 - Y1);
const path = (pts: [number, number][]) => {
  // smooth Catmull-Rom → Bezier
  const P = pts.map(([a, b]) => [x(a), y(b)]);
  let d = `M${P[0][0]} ${P[0][1]}`;
  for (let i = 0; i < P.length - 1; i++) {
    const p0 = P[i - 1] ?? P[i], p1 = P[i], p2 = P[i + 1], p3 = P[i + 2] ?? p2;
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${c1[0].toFixed(1)} ${c1[1].toFixed(1)} ${c2[0].toFixed(1)} ${c2[1].toFixed(1)} ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
  }
  return d;
};
const crt = path([[1950, .8], [1965, .84], [1980, .88], [1995, .9], [2008, .9]]);
const crtHold = path([[2008, .9], [2018, .9], [2027, .9]]);
const lcd = path([[2000, .1], [2006, .18], [2012, .27], [2018, .36], [2027, .44]]);
const oled = path([[2010, .4], [2015, .5], [2020, .62], [2024, .72], [2027, .79]]);
const vrD = `M${x(2027)} ${y(.9)} C${x(2028.3)} ${y(.95)} ${x(2029.2)} ${y(1.25)} ${x(2030.2)} ${y(1.62)}`;
const ticks = [1950, 1970, 1990, 2010, 2026];
---
<div class="crtvr cx mlc" id={id} data-mlc>
  <div class="cx-head">
    <span class="cx-tag">Motion clarity, by era</span>
    <span class="cx-note">Qualitative · not to scale</span>
  </div>
  <div class="cx-frame mlc-frame">
    <svg viewBox="0 -80 1000 530" role="img" aria-labelledby={`${id}-t`} data-svg>
      <title id={`${id}-t`}>Motion clarity by era, qualitative. CRT held the top for decades and is still kept by holdouts. LCD never caught up. OLED is still chasing with black-frame insertion and 480 Hz. CRT-VR breaks off the top of the chart.</title>
      <defs>
        <clipPath id={`${id}-clip`}><rect data-clip x="0" y="-200" width={X0} height="800" /></clipPath>
        <filter id={`${id}-glow`} x="-20%" y="-50%" width="140%" height="200%">
          <feGaussianBlur stdDeviation="5" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
        <linearGradient id={`${id}-six`} x1="0" y1="1" x2="0" y2="0">
          <stop offset="0" stop-color="#00ff99" /><stop offset=".35" stop-color="#00e5ff" /><stop offset=".6" stop-color="#3a6bff" /><stop offset=".8" stop-color="#ff3cc8" /><stop offset="1" stop-color="#ffe135" />
        </linearGradient>
        <linearGradient id={`${id}-crown`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#00ff99" stop-opacity=".16" /><stop offset="1" stop-color="#00ff99" stop-opacity="0" />
        </linearGradient>
      </defs>

      <!-- plot frame and ceiling -->
      <line x1={X0} y1={Y0} x2={X1} y2={Y0} class="axis" />
      <line x1={X0} y1={Y0} x2={X0} y2={Y1 - 10} class="axis" />
      <line x1={X0} y1={Y1} x2={X1} y2={Y1} class="ceiling" />
      <text x={X1} y={Y1 - 10} text-anchor="end" class="lbl dim">Top of the chart</text>
      {ticks.map((t) => (<g><line x1={x(t)} y1={Y0} x2={x(t)} y2={Y0 + 6} class="axis" /><text x={x(t)} y={Y0 + 26} text-anchor="middle" class="tick">{t === 2026 ? 'Today' : `${t}s`}</text></g>))}
      <text transform={`translate(${X0 - 24} ${(Y0 + Y1) / 2}) rotate(-90)`} text-anchor="middle" class="lbl">Motion clarity →</text>

      <g clip-path={`url(#${id}-clip)`}>
        <path d={`${crt} L${x(2008)} ${Y0} L${x(1950)} ${Y0} Z`} fill={`url(#${id}-crown)`} />
        <path d={crt} class="ln crt" />
        <path d={crtHold} class="ln crt hold" />
        <path d={lcd} class="ln lcd" />
        <path d={oled} class="ln oled" />
        <path d={vrD} class="ln vr" stroke={`url(#${id}-six)`} data-vr />
      </g>

      <g class="ann" data-at="1958"><text x={x(1958)} y={y(.8) - 40} class="lbl crt-c">CRT</text><text x={x(1958)} y={y(.8) - 22} class="sub">Owned motion for decades</text></g>
      <g class="ann" data-at="2012"><text x={x(2010)} y={y(.9) - 22} class="lbl crt-c">Holdouts</text><text x={x(2010)} y={y(.9) - 6} class="sub">Esports players and purists</text></g>
      <g class="ann" data-at="2004"><text x={x(2003)} y={y(.1) + 30} class="lbl lcd-c">LCD</text><text x={x(2003)} y={y(.1) + 46} class="sub">Never caught up</text></g>
      <g class="ann" data-at="2014"><text x={x(2013)} y={y(.45) + 34} class="lbl oled-c">OLED</text><text x={x(2013)} y={y(.45) + 50} class="sub">Black-frame tricks, 480 Hz races</text></g>
      <g class="ann vr-ann" data-at="2029.5">
        <text x={x(2030.2) - 14} y={y(1.62) + 6} text-anchor="end" class="vr-name">CRT-VR</text>
        <text x={x(2030.2) - 14} y={y(1.62) + 26} text-anchor="end" class="sub">Widens the gap</text>
      </g>
      <circle class="flare" cx={x(2030.2)} cy={y(1.62)} r="7" data-flare />

      <line class="cursor" data-cursor x1={X0} x2={X0} y1={Y1 - 20} y2={Y0} />
      <text class="cursor-yr" data-cursor-yr x={X0} y={Y1 - 28} text-anchor="middle">1950</text>
    </svg>
  </div>
</div>

<style>
  .mlc-frame { padding: 10px 6px 0; }
  .mlc svg { width: 100%; height: auto; overflow: visible; font-family: var(--crtvr-font-mono); }
  .axis { stroke: var(--crtvr-line-bright); stroke-width: 1; }
  .ceiling { stroke: var(--crtvr-text-dimmer); stroke-dasharray: 3 6; }
  .tick { font-size: 12px; fill: var(--crtvr-text-dim); letter-spacing: .08em; }
  .lbl { font-size: 12px; letter-spacing: .18em; text-transform: uppercase; fill: var(--crtvr-text-dim); }
  .lbl.dim { fill: var(--crtvr-text-dimmer); font-size: 10px; }
  .sub { font-family: var(--crtvr-font-serif); font-style: italic; font-weight: 300; font-size: 15px; fill: var(--crtvr-text); }
  .crt-c { fill: var(--crtvr-phosphor); } .lcd-c { fill: var(--crtvr-panel-cold); } .oled-c { fill: var(--crtvr-orange); }
  .ln { fill: none; stroke-width: 3; stroke-linecap: round; }
  .ln.crt { stroke: var(--crtvr-phosphor); }
  .ln.crt.hold { stroke-dasharray: 2 8; stroke-width: 2.5; }
  .ln.lcd { stroke: var(--crtvr-panel-cold); stroke-width: 2.5; }
  .ln.oled { stroke: var(--crtvr-orange); stroke-width: 2.5; }
  .ln.vr { stroke-width: 5; }
  :global(html[data-vfx-tier="full"]) .mlc .ln.crt:not(.hold), :global(html[data-vfx-tier="full"]) .mlc .ln.vr { filter: drop-shadow(0 0 6px #00ff99); }
  .ann { opacity: 0; transition: opacity .6s var(--crtvr-ease-out); }
  .ann.on { opacity: 1; }
  .vr-name { font-family: var(--crtvr-font-display); font-size: 44px; fill: #f0f4ff; }
  .flare { fill: #fff; opacity: 0; transition: opacity .3s; }
  .mlc.is-vr .flare { opacity: 1; }
  :global(html[data-vfx-tier="full"]) .mlc.is-vr .flare { filter: drop-shadow(0 0 10px #fff) drop-shadow(0 0 26px #00e5ff); animation: mlc-pulse 1.6s ease-in-out infinite; }
  @keyframes mlc-pulse { 50% { opacity: .55; } }
  .cursor { stroke: #f0f4ff; stroke-opacity: .5; stroke-width: 1; }
  .cursor-yr { font-family: var(--crtvr-font-display); font-size: 22px; fill: #f0f4ff; }
  .mlc.is-static .cursor, .mlc.is-static .cursor-yr { display: none; }
</style>

<script>
  import { onTier } from '../../visuals/crt-vr/lib/tier';
  import { scrubLoop, passProgress, seg, easeInOut } from '../../visuals/crt-vr/lib/scrub';
  import { widen } from './lib/wide';

  const X0 = 90, X1 = 930, Y_MIN = 1950, Y_MAX = 2032;
  const xOf = (yr: number) => X0 + ((yr - Y_MIN) / (Y_MAX - Y_MIN)) * (X1 - X0);

  function init(root: HTMLElement) {
    widen(root);
    const clip = root.querySelector<SVGRectElement>('[data-clip]')!;
    const cursor = root.querySelector<SVGLineElement>('[data-cursor]')!;
    const cyr = root.querySelector<SVGTextElement>('[data-cursor-yr]')!;
    const anns = Array.from(root.querySelectorAll<SVGGElement>('.ann'));
    let stop: (() => void) | null = null;

    const render = (p: number) => {
      const t = easeInOut(seg(p, 0.18, 0.62));
      const yr = Y_MIN + t * (2031 - Y_MIN);
      const cx = xOf(yr);
      clip.setAttribute('width', String(cx + 40 * (yr > 2027 ? 1 : 0)));
      cursor.setAttribute('x1', String(cx)); cursor.setAttribute('x2', String(cx));
      cyr.setAttribute('x', String(cx));
      cyr.textContent = yr >= 2026 ? 'Today' : `${Math.floor(yr / 10) * 10}s`;
      anns.forEach((a) => a.classList.toggle('on', yr >= +a.dataset.at!));
      root.classList.toggle('is-vr', yr >= 2030);
    };
    const drawAll = () => { clip.setAttribute('width', '2000'); anns.forEach((a) => a.classList.add('on')); root.classList.add('is-vr'); };

    onTier((t) => {
      root.classList.toggle('is-static', t === 'static');
      if (t === 'static') { stop?.(); stop = null; drawAll(); }
      else if (!stop) stop = scrubLoop(root, passProgress, render, { smoothing: t === 'full' ? 0.12 : 0.3 });
    });
  }
  document.querySelectorAll<HTMLElement>('[data-mlc]').forEach(init);
</script>
