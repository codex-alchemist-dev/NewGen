---
interface Props {
  label: string;
  value?: string;
  unit?: string;
  note?: string;
}
const { label, value = '—', unit, note } = Astro.props;
---
<figure class="stat-card">
  <figcaption class="eyebrow">{label}</figcaption>
  <p class="stat-card__value display">{value}{unit && <span class="stat-card__unit">{unit}</span>}</p>
  {note && <p class="stat-card__note">{note}</p>}
</figure>
