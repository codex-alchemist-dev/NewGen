---
/**
 * PersistenceCursor: the pointer is an electron beam on a phosphor screen.
 * The trail lights white-hot, then decays with a two-stage phosphor
 * persistence curve (fast fluorescence drop + long phosphorescent tail),
 * cooling from white to the live section tint.
 *
 * full only. Hidden on touch / coarse pointers, reduced and static tiers.
 * The rAF loop sleeps when the trail has fully decayed.
 */
---
<canvas class="vfx-cursor" aria-hidden="true"></canvas>

<style>
  .vfx-cursor {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 950;
    pointer-events: none;
    mix-blend-mode: screen;
  }
  :global(html:not([data-vfx-tier='full'])) .vfx-cursor { display: none; }
  @media (pointer: coarse) {
    .vfx-cursor { display: none; }
  }
</style>

<script>
  import { getTier } from './quality';

  const canvas = document.querySelector<HTMLCanvasElement>('.vfx-cursor');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx && matchMedia('(pointer: fine)').matches) {
    const LIFE = 900; // ms until fully dark
    // Two-stage persistence: 70% fluorescence (τ≈40 ms) + 30% phosphorescence (τ≈320 ms)
    const persist = (age: number) => 0.7 * Math.exp(-age / 40) + 0.3 * Math.exp(-age / 320);
    type P = { x: number; y: number; t: number };
    const pts: P[] = [];
    let running = false;
    let dpr = 1;

    const resize = () => {
      dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = innerWidth * dpr;
      canvas.height = innerHeight * dpr;
    };
    resize();
    addEventListener('resize', resize);

    addEventListener(
      'pointermove',
      (e) => {
        if (getTier() !== 'full' || e.pointerType !== 'mouse') return;
        const now = performance.now();
        const last = pts[pts.length - 1];
        // interpolate fast moves so the beam path stays continuous
        if (last) {
          const dx = e.clientX - last.x;
          const dy = e.clientY - last.y;
          const steps = Math.min(12, Math.floor(Math.hypot(dx, dy) / 14));
          for (let i = 1; i < steps; i++) {
            const f = i / steps;
            pts.push({ x: last.x + dx * f, y: last.y + dy * f, t: last.t + (now - last.t) * f });
          }
        }
        pts.push({ x: e.clientX, y: e.clientY, t: now });
        if (!running) {
          running = true;
          requestAnimationFrame(draw);
        }
      },
      { passive: true }
    );

    function draw(now: number) {
      while (pts.length && now - pts[0].t > LIFE) pts.shift();
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx!.clearRect(0, 0, innerWidth, innerHeight);
      if (!pts.length) {
        running = false;
        return;
      }
      const tint = getComputedStyle(document.documentElement).getPropertyValue('--vfx-tint-rgb').trim().split(/\s+/).map(Number);
      const [tr, tg, tb] = tint.length === 3 && tint.every((n) => !isNaN(n)) ? tint : [0, 255, 153];
      ctx!.globalCompositeOperation = 'lighter';
      ctx!.lineCap = 'round';
      for (let i = 1; i < pts.length; i++) {
        const a = pts[i - 1];
        const b = pts[i];
        const age = now - b.t;
        const I = persist(age);
        if (I < 0.01) continue;
        const hot = Math.exp(-age / 60); // white-hot fraction
        const r = Math.round(tr + (255 - tr) * hot);
        const g = Math.round(tg + (255 - tg) * hot);
        const bl = Math.round(tb + (255 - tb) * hot);
        // halo
        ctx!.strokeStyle = `rgba(${tr},${tg},${tb},${(I * 0.18).toFixed(3)})`;
        ctx!.lineWidth = 10 + 8 * I;
        ctx!.beginPath();
        ctx!.moveTo(a.x, a.y);
        ctx!.lineTo(b.x, b.y);
        ctx!.stroke();
        // core
        ctx!.strokeStyle = `rgba(${r},${g},${bl},${(I * 0.9).toFixed(3)})`;
        ctx!.lineWidth = 1.2 + 1.8 * I;
        ctx!.beginPath();
        ctx!.moveTo(a.x, a.y);
        ctx!.lineTo(b.x, b.y);
        ctx!.stroke();
      }
      // beam spot at the head
      const h = pts[pts.length - 1];
      const ha = persist(now - h.t);
      const grd = ctx!.createRadialGradient(h.x, h.y, 0, h.x, h.y, 16);
      grd.addColorStop(0, `rgba(255,255,255,${(0.9 * ha).toFixed(3)})`);
      grd.addColorStop(0.3, `rgba(${tr},${tg},${tb},${(0.5 * ha).toFixed(3)})`);
      grd.addColorStop(1, 'rgba(0,0,0,0)');
      ctx!.fillStyle = grd;
      ctx!.beginPath();
      ctx!.arc(h.x, h.y, 16, 0, Math.PI * 2);
      ctx!.fill();
      requestAnimationFrame(draw);
    }
  }
</script>
