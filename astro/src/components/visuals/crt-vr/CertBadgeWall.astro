---
/**
 * CRT-VR · Act 11 · "Certified, top to bottom." — the badge wall.
 *
 * Original NewGen badge tiles, text only: no certifier logos or marks. Each tile
 * names the target certification and a one-word category. Tiles rise in on a
 * stagger and a foil shimmer sweeps across each one; the foil rim drifts and
 * follows the pointer on hover.
 *
 * Tiers: full (rise + shimmer + drifting foil + pointer light), reduced (fade +
 * one shimmer, no drift or tilt), static (tiles shown, no motion).
 */
import './tokens.css';
import type { VfxSlotProps } from '../../../lib/motion/types';

interface Props extends Partial<VfxSlotProps> { id?: string; items?: { label: string }[] }
const { id = 'crtvr-certs', items = [] } = Astro.props;

// Display split for each target certification (text only). Category words approved by the coordinator.
const SPLIT: Record<string, { cat: string; top?: string; main: string; big?: string; sub?: string }> = {
  'VESA DisplayHDR 1400': { cat: 'HDR', top: 'VESA', main: 'DisplayHDR', big: '1400' },
  'DisplayHDR True Black 1000': { cat: 'Black', top: 'DisplayHDR', main: 'True Black', big: '1000' },
  'ClearMR 21000': { cat: 'Motion', main: 'ClearMR', big: '21000' },
  'AdaptiveSync Display': { cat: 'Sync', main: 'AdaptiveSync', sub: 'Display' },
  'AMD FreeSync Premium Pro': { cat: 'Sync', top: 'AMD', main: 'FreeSync', sub: 'Premium Pro' },
  'NVIDIA G-SYNC (Pulsar-class)': { cat: 'Sync', top: 'NVIDIA', main: 'G-SYNC', sub: 'Pulsar-class' },
  'Pantone Validated + SkinTone Validated': { cat: 'Color', top: 'Pantone', main: 'Validated', sub: '+ SkinTone Validated' },
  'Calman Verified': { cat: 'Calibration', main: 'Calman', sub: 'Verified' },
  'TÜV Rheinland Low Blue Light (Hardware) + Eye Comfort': { cat: 'Comfort', top: 'TÜV Rheinland', main: 'Low Blue Light', sub: 'Hardware + Eye Comfort' },
};
const tiles = items.map((i) => ({ label: i.label, ...(SPLIT[i.label] ?? { cat: 'Certified', main: i.label }) }));
---
<div class="crtvr cbw" id={id} data-cbw>
  <ul class="cbw-grid">
    {tiles.map((t, n) => (
      <li class="cbw-tile" style={`--n:${n}`} data-tile>
        <div class="cbw-face" aria-label={`${t.label}. Category: ${t.cat}.`} role="img">
          <div class="cbw-row" aria-hidden="true">
            <span class="cbw-cat">{t.cat}</span>
            <span class="cbw-idx">№{String(n + 1).padStart(2, '0')}</span>
          </div>
          <div class="cbw-name" aria-hidden="true">
            {t.top && <span class="cbw-top">{t.top}</span>}
            <span class="cbw-main">{t.main}</span>
            {t.big && <span class="cbw-big">{t.big}</span>}
            {t.sub && <span class="cbw-sub">{t.sub}</span>}
          </div>
          <div class="cbw-row cbw-foot" aria-hidden="true">
            <span>Target</span><span>NewGen × Sony · CRT-VR</span>
          </div>
          <span class="cbw-shine" aria-hidden="true"></span>
        </div>
      </li>
    ))}
  </ul>
</div>

<style>
  @property --cbw-a { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  .cbw { position: relative; margin: var(--s-6, 48px) 0; width: var(--wide-w, 100%); margin-left: var(--wide-x, 0px); font-family: var(--crtvr-font-mono); perspective: 1200px; }
  .cbw-grid { list-style: none; display: grid; gap: 16px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 900px) { .cbw-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .cbw-grid { grid-template-columns: 1fr; } }

  .cbw-tile {
    --mx: 50%; --my: 30%;
    position: relative; border-radius: 10px; padding: 1.5px;
    background: conic-gradient(from var(--cbw-a) at var(--mx) var(--my), #ff2d20, #ffe135, #00ff99, #00e5ff, #3a6bff, #ff3cc8, #ff2d20);
    opacity: 0; transform: translateY(26px) rotateX(38deg); transform-origin: 50% 100%;
    transition: opacity .9s calc(var(--n) * 110ms) var(--crtvr-ease-out), transform 1.1s calc(var(--n) * 110ms) var(--crtvr-ease-out);
  }
  .cbw-tile::before { /* soft foil glow behind */
    content: ''; position: absolute; inset: -1px; border-radius: inherit; z-index: -1; background: inherit; filter: blur(14px); opacity: .18; transition: opacity .4s;
  }
  .cbw-tile:hover::before { opacity: .45; }
  .cbw.is-on .cbw-tile { opacity: 1; transform: none; }
  :global(html[data-vfx-tier="full"]) .cbw.is-on .cbw-tile { animation: cbw-drift 9s linear infinite; }
  @keyframes cbw-drift { to { --cbw-a: 360deg; } }

  .cbw-face {
    position: relative; overflow: hidden; border-radius: 9px; min-height: 210px; height: 100%;
    display: grid; grid-template-rows: auto 1fr auto; gap: 10px; padding: 16px 18px 14px;
    background:
      radial-gradient(120% 90% at var(--mx) var(--my), rgba(240, 244, 255, .07), transparent 60%),
      repeating-linear-gradient(135deg, rgba(240,244,255,.025) 0 1px, transparent 1px 7px),
      linear-gradient(180deg, #0b1020, #05070e);
  }
  .cbw-row { display: flex; justify-content: space-between; align-items: center; font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--crtvr-text-dim); }
  .cbw-cat { color: var(--crtvr-white); border: 1px solid var(--crtvr-line-bright); padding: 3px 8px; border-radius: 999px; }
  .cbw-name { display: grid; align-content: center; gap: 2px; }
  .cbw-top { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--crtvr-text-dim); }
  .cbw-main { font-family: var(--crtvr-font-display); font-size: clamp(30px, 3.2vw, 40px); line-height: .95; color: var(--crtvr-white); letter-spacing: .02em; }
  .cbw-big {
    font-family: var(--crtvr-font-display); font-size: clamp(44px, 5vw, 64px); line-height: .9;
    background: linear-gradient(100deg, #f0f4ff 10%, #00e5ff 45%, #ff3cc8 70%, #ffe135 95%); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .cbw-sub { font-family: var(--crtvr-font-serif); font-style: italic; font-weight: 300; font-size: 17px; color: var(--crtvr-text); }
  .cbw-foot { border-top: 1px solid var(--crtvr-line); padding-top: 10px; font-size: 9px; color: var(--crtvr-text-dimmer); }

  .cbw-shine {
    position: absolute; inset: -40% -60%; pointer-events: none;
    background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,.0) 42%, rgba(255,255,255,.22) 48%, rgba(0,229,255,.18) 51%, rgba(255,60,200,.12) 54%, transparent 60%);
    transform: translateX(-70%);
  }
  .cbw.is-on .cbw-shine { animation: cbw-shine 1.6s calc(var(--n) * 110ms + .45s) var(--crtvr-ease-out) both; }
  :global(html[data-vfx-tier="full"]) .cbw.is-on .cbw-tile:hover .cbw-shine { animation: cbw-shine 1.1s var(--crtvr-ease-out) both; }
  @keyframes cbw-shine { from { transform: translateX(-70%); } to { transform: translateX(70%); } }

  .cbw.is-static .cbw-tile { opacity: 1; transform: none; transition: none; animation: none !important; }
  .cbw.is-static .cbw-shine { display: none; }
</style>

<script>
  import { onTier, type VfxTier } from './lib/tier';

  function init(root: HTMLElement) {
    const box = (root.closest('.act__inner') as HTMLElement | null) ?? root.parentElement!;
    const fit = () => {
      root.style.setProperty('--wide-x', '0px'); root.style.setProperty('--wide-w', '100%');
      const b = box.getBoundingClientRect(), r = root.getBoundingClientRect();
      root.style.setProperty('--wide-w', `${b.width}px`); root.style.setProperty('--wide-x', `${b.left - r.left}px`);
    };
    fit(); window.addEventListener('resize', fit);

    let tier: VfxTier = 'full';
    onTier((t) => { tier = t; root.classList.toggle('is-static', t === 'static'); if (t === 'static') root.classList.add('is-on'); });
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); root.classList.add('is-on'); } }, { threshold: 0.2 });
    io.observe(root);

    root.querySelectorAll<HTMLElement>('[data-tile]').forEach((tile) => {
      tile.addEventListener('pointermove', (e) => {
        if (tier !== 'full') return;
        const r = tile.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width, py = (e.clientY - r.top) / r.height;
        tile.style.setProperty('--mx', `${px * 100}%`); tile.style.setProperty('--my', `${py * 100}%`);
        tile.style.transform = `rotateX(${(0.5 - py) * 8}deg) rotateY(${(px - 0.5) * 10}deg)`;
        tile.style.transition = 'transform .15s';
      });
      tile.addEventListener('pointerleave', () => { tile.style.transform = ''; tile.style.transition = ''; });
    });
  }
  document.querySelectorAll<HTMLElement>('[data-cbw]').forEach(init);
</script>
