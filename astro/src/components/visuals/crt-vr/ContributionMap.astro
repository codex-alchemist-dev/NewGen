---
/**
 * CRT-VR · Act 1 · "Built by NewGen" — slot `contribution-map`.
 *
 * A left-to-right flow: NewGen members → what each brings → CRT-VR → the launch
 * partners that ship it. Light travels along every line. Hover or focus a member
 * to light only its contributions. Text labels only, no logos.
 * ShallXR and Play For Dream are customers (they ship CRT-VR), not contributors.
 *
 * Tiers: full (flowing light + glow), reduced (lines draw, no flow), static (drawn).
 */
import './tokens.css';
import type { VfxSlotProps } from '../../../lib/motion/types';

interface Props extends Partial<VfxSlotProps> { id?: string }
const { id = 'crtvr-contrib' } = Astro.props;

const members = [
  { key: 'sony', name: 'Sony', brings: 'Tube · color · glass', y: 120, color: '#ff2d20' },
  { key: 'intel', name: 'Intel Eventide', brings: 'iDP link · scan silicon', y: 280, color: '#00b4ff' },
  { key: 'lm', name: 'Lightmatter', brings: 'Photonic interconnect', y: 420, color: '#cc44ff' },
];
const parts = [
  { m: 'sony', label: 'Tube', y: 60 },
  { m: 'sony', label: 'Color', y: 120 },
  { m: 'sony', label: 'Glass', y: 180 },
  { m: 'intel', label: 'iDP link', y: 255 },
  { m: 'intel', label: 'Scan silicon', y: 305 },
  { m: 'lm', label: 'Photonic interconnect', y: 420 },
];
const partners = [{ name: 'ShallXR', y: 210 }, { name: 'Play For Dream', y: 330 }];
const CX = 790, CY = 270, CR = 96;
const MX = 60, MW = 210, PX = 380, PW = 240, QX = 1010;
const six = ['#ff2d20', '#ffe135', '#00ff99', '#00e5ff', '#3a6bff', '#ff3cc8'];
const colorOf = (k: string) => members.find((m) => m.key === k)!.color;
const curve = (x0: number, y0: number, x1: number, y1: number) => {
  const dx = (x1 - x0) * 0.5;
  return `M${x0} ${y0} C${x0 + dx} ${y0} ${x1 - dx} ${y1} ${x1} ${y1}`;
};
---
<div class="crtvr cmap" id={id} data-cmap>
  <svg class="cmap-svg" viewBox="0 -24 1200 544" role="img" aria-labelledby={`${id}-t`}>
    <title id={`${id}-t`}>Built by NewGen. Sony brings the tube, color and glass. Intel Eventide brings the iDP link and scan silicon. Lightmatter brings the photonic interconnect. CRT-VR ships with launch partners ShallXR and Play For Dream.</title>
    <defs>
      <filter id={`${id}-glow`} x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="4" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
      <radialGradient id={`${id}-core`} cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#0d2a22" /><stop offset=".7" stop-color="#07110f" /><stop offset="1" stop-color="#04050a" />
      </radialGradient>
    </defs>

    <text class="col" x={MX} y="22">NewGen members</text>
    <text class="col" x={PX} y="22">What they bring</text>
    <text class="col" x={CX} y="22" text-anchor="middle">One panel</text>
    <text class="col" x={QX} y="168">Launch partners</text>

    <!-- members → parts -->
    {parts.map((p, i) => {
      const m = members.find((mm) => mm.key === p.m)!;
      return (
        <g class="flow" data-m={p.m} style={`--c:${m.color}; --d:${i * 120}ms`}>
          <path class="base" d={curve(MX + MW, m.y, PX, p.y)} pathLength="1" />
          <path class="light" d={curve(MX + MW, m.y, PX, p.y)} />
        </g>
      );
    })}
    <!-- parts → core -->
    {parts.map((p, i) => {
      const a = (-0.95 + i * 0.38);
      const ex = CX - CR * Math.cos(a * 0.9), ey = CY + CR * Math.sin(a * 0.9);
      return (
        <g class="flow" data-m={p.m} style={`--c:${colorOf(p.m)}; --d:${700 + i * 120}ms`}>
          <path class="base" d={curve(PX + PW, p.y, ex, ey)} pathLength="1" />
          <path class="light" d={curve(PX + PW, p.y, ex, ey)} />
        </g>
      );
    })}
    <!-- core → partners -->
    {partners.map((q, i) => (
      <g class="flow out" style={`--c:#00ff99; --d:${1700 + i * 150}ms`}>
        <path class="base" d={curve(CX + CR, CY + (q.y - CY) * 0.4, QX, q.y)} pathLength="1" />
        <path class="light" d={curve(CX + CR, CY + (q.y - CY) * 0.4, QX, q.y)} />
      </g>
    ))}

    {members.map((m) => (
      <g class="member" data-m={m.key} tabindex="0" style={`--c:${m.color}`} role="button" aria-label={`${m.name}: ${m.brings}`}>
        <rect x={MX} y={m.y - 34} width={MW} height="68" rx="6" />
        <rect class="bar" x={MX} y={m.y - 34} width="4" height="68" />
        <text class="m-name" x={MX + 18} y={m.y - 4}>{m.name}</text>
        <text class="m-brings" x={MX + 18} y={m.y + 18}>{m.brings}</text>
      </g>
    ))}
    {parts.map((p) => (
      <g class="part" data-m={p.m} style={`--c:${colorOf(p.m)}`}>
        <rect x={PX} y={p.y - 18} width={PW} height="36" rx="18" />
        <circle cx={PX + 18} cy={p.y} r="4" />
        <text x={PX + 32} y={p.y + 5}>{p.label}</text>
      </g>
    ))}

    <g class="core">
      <circle cx={CX} cy={CY} r={CR + 26} class="halo" />
      {six.map((c, k) => (
        <circle cx={CX} cy={CY} r={CR + 8} stroke={c} class="ring" pathLength="6" stroke-dasharray="0.9 5.1" stroke-dashoffset={-k} />
      ))}
      <circle cx={CX} cy={CY} r={CR} fill={`url(#${id}-core)`} stroke="#1a2240" />
      <text x={CX} y={CY - 18} text-anchor="middle" class="core-ng">NewGen × Sony</text>
      <text x={CX} y={CY + 26} text-anchor="middle" class="core-name">CRT-VR</text>
    </g>

    {partners.map((q) => (
      <g class="partner">
        <rect x={QX} y={q.y - 26} width="180" height="52" rx="6" />
        <text x={QX + 16} y={q.y + 6}>{q.name}</text>
      </g>
    ))}
  </svg>

  <!-- narrow screens: the same map as a stacked list -->
  <ol class="cmap-list">
    {members.map((m) => (
      <li style={`--c:${m.color}`}><span class="n">{m.name}</span><span class="b">{m.brings}</span></li>
    ))}
    <li class="core-li"><span class="n">CRT-VR</span></li>
    <li class="partners-li"><span class="b">Launch partners</span><span class="n">ShallXR · Play For Dream</span></li>
  </ol>
</div>

<style>
  .cmap { position: relative; margin: var(--s-6, 48px) 0; width: var(--wide-w, 100%); margin-left: var(--wide-x, 0px); font-family: var(--crtvr-font-mono); }
  .cmap-svg { position: relative; width: 100%; height: auto; overflow: visible; }
  .cmap::before { content: ''; position: absolute; inset: -4% -2%; pointer-events: none; background: radial-gradient(ellipse at 55% 50%, rgba(4,5,10,.88), rgba(4,5,10,.6) 60%, transparent 80%); }
  .col { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; fill: var(--crtvr-text-dim); }
  .flow path { fill: none; }
  .flow .base { stroke: var(--c); stroke-opacity: .35; stroke-width: 1.5; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.1s var(--d) var(--crtvr-ease-out), stroke-opacity .3s; }
  .flow .light { stroke: var(--c); stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 2 46; opacity: 0; transition: opacity .3s; }
  .cmap.is-on .flow .base { stroke-dashoffset: 0; }
  .cmap.is-on.is-flow .flow .light { opacity: .95; animation: cmap-flow 2.4s linear infinite; animation-delay: calc(var(--d) + 1s); }
  :global(html[data-vfx-tier="full"]) .cmap .flow .light { filter: drop-shadow(0 0 4px var(--c)); }
  @keyframes cmap-flow { to { stroke-dashoffset: -48; } }

  .member rect { fill: color-mix(in srgb, var(--c) 8%, #04050a); stroke: color-mix(in srgb, var(--c) 45%, #1a2240); transition: fill .3s, filter .3s; }
  .member .bar { fill: var(--c); stroke: none; }
  .member { cursor: pointer; outline: none; }
  .member:focus-visible rect:first-child { stroke: #fff; }
  .m-name { font-family: var(--crtvr-font-display); font-size: 30px; letter-spacing: .03em; fill: #f0f4ff; }
  .m-brings { font-size: 12px; letter-spacing: .08em; fill: var(--c); }
  .part rect { fill: #080b14; stroke: color-mix(in srgb, var(--c) 50%, #1a2240); transition: stroke .3s, fill .3s; }
  .part circle { fill: var(--c); }
  .part text { font-size: 14px; letter-spacing: .06em; fill: #d8e4ff; }
  .partner rect { fill: color-mix(in srgb, #00ff99 6%, #04050a); stroke: color-mix(in srgb, #00ff99 40%, #1a2240); }
  .partner text { font-size: 15px; letter-spacing: .06em; fill: #f0f4ff; }
  .core .halo { fill: none; stroke: #00ff99; stroke-opacity: .12; stroke-width: 30; }
  .core .ring { fill: none; stroke-width: 3; }
  .core-ng { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; fill: #00ff99; }
  .core-name { font-family: var(--crtvr-font-display); font-size: 54px; fill: #f0f4ff; }
  .cmap.is-on.is-flow .core .ring { animation: cmap-spin 14s linear infinite; transform-origin: 790px 270px; }
  @keyframes cmap-spin { to { transform: rotate(360deg); } }
  :global(html[data-vfx-tier="full"]) .cmap .core-name { filter: drop-shadow(0 0 10px rgba(0, 255, 153, .45)); }

  .member, .part, .core, .partner { opacity: 0; transition: opacity .8s var(--crtvr-ease-out); }
  .cmap.is-on .member { opacity: 1; }
  .cmap.is-on .part { opacity: 1; transition-delay: .5s; }
  .cmap.is-on .core { opacity: 1; transition-delay: 1.3s; }
  .cmap.is-on .partner { opacity: 1; transition-delay: 1.9s; }

  /* focus one member */
  .cmap[data-focus] .flow:not(.out), .cmap[data-focus] .part, .cmap[data-focus] .member { opacity: .18; }
  .cmap[data-focus="sony"] [data-m="sony"], .cmap[data-focus="intel"] [data-m="intel"], .cmap[data-focus="lm"] [data-m="lm"] { opacity: 1; }
  .cmap[data-focus="sony"] .member[data-m="sony"] rect:first-child,
  .cmap[data-focus="intel"] .member[data-m="intel"] rect:first-child,
  .cmap[data-focus="lm"] .member[data-m="lm"] rect:first-child { fill: color-mix(in srgb, var(--c) 22%, #04050a); }

  .cmap-list { display: none; list-style: none; gap: 10px; }
  .cmap-list li { display: grid; gap: 2px; padding: 12px 14px; border: 1px solid color-mix(in srgb, var(--c, #00ff99) 40%, #1a2240); border-left: 3px solid var(--c, #00ff99); border-radius: 4px; }
  .cmap-list .n { font-family: var(--crtvr-font-display); font-size: 26px; color: #f0f4ff; }
  .cmap-list .b { font-size: 12px; letter-spacing: .08em; color: var(--c, #00ff99); }
  .cmap-list .core-li { text-align: center; border-left-width: 1px; }
  .cmap-list .core-li .n { font-size: 44px; background: linear-gradient(90deg, #ff2d20, #ffe135, #00ff99, #00e5ff, #3a6bff, #ff3cc8); -webkit-background-clip: text; background-clip: text; color: transparent; }
  @media (max-width: 640px) { .cmap-svg { display: none; } .cmap-list { display: grid; } }

  .cmap.is-static * { transition: none !important; animation: none !important; }
</style>

<script>
  import { onTier } from './lib/tier';

  function init(root: HTMLElement) {
    const box = (root.closest('.act__inner') as HTMLElement | null) ?? root.parentElement!;
    const fit = () => {
      root.style.setProperty('--wide-x', '0px'); root.style.setProperty('--wide-w', '100%');
      const b = box.getBoundingClientRect(), r = root.getBoundingClientRect();
      root.style.setProperty('--wide-w', `${b.width}px`); root.style.setProperty('--wide-x', `${b.left - r.left}px`);
    };
    fit(); window.addEventListener('resize', fit);

    onTier((t) => {
      root.classList.toggle('is-static', t === 'static');
      root.classList.toggle('is-flow', t === 'full');
      if (t === 'static') root.classList.add('is-on');
    });
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { io.disconnect(); root.classList.add('is-on'); }
    }, { threshold: 0.25 });
    io.observe(root);

    root.querySelectorAll<SVGGElement>('.member').forEach((g) => {
      const on = () => { root.dataset.focus = g.dataset.m!; };
      const off = () => { delete root.dataset.focus; };
      g.addEventListener('pointerenter', on); g.addEventListener('pointerleave', off);
      g.addEventListener('focus', on); g.addEventListener('blur', off);
    });
  }
  document.querySelectorAll<HTMLElement>('[data-cmap]').forEach(init);
</script>
