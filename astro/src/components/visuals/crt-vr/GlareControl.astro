---
/**
 * CRT-VR · Act 8 · Glare and ghost control (small visual).
 * Cross-section of the relay barrel. Stray light from the bright phosphor hits the barrel
 * walls. A bare barrel bounces it toward the eye as veiling glare, lifting the black floor.
 * A Kurocoat-lined barrel with baffles absorbs it, so black stays black.
 */
import './tokens.css';
import '../../interactives/crt-vr/wraparound/wraparound.css';
import type { VfxSlotProps } from '../../../lib/motion/types';
interface Props extends Partial<VfxSlotProps> { id?: string }
const { id = 'crtvr-glare' } = Astro.props;
const baffles = [70, 110, 150];
---
<figure class="wo crtvr glare" id={id} data-glare data-mode="kuro" aria-label="Glare and ghost control with a Kurocoat-lined barrel">
  <p class="wo__eyebrow">Visual · Glare and ghost control</p>
  <div class="wo__grid2" style="grid-template-columns:minmax(0,2fr) minmax(0,1fr)">
    <svg class="wo__svg" viewBox="0 0 400 220" role="img" aria-label="Stray rays inside the relay barrel, either bouncing to the eye or absorbed by the Kurocoat lining">
      <rect width="400" height="220" fill="#020306" />
      <!-- phosphor (top) and eye (bottom) -->
      <rect x="120" y="14" width="160" height="5" fill="#e8fbff" />
      <text x="200" y="10" text-anchor="middle" font-size="9" fill="#6a7fa8">bright phosphor</text>
      <ellipse cx="200" cy="206" rx="26" ry="9" fill="#0b1018" stroke="#c8f6ff" stroke-opacity=".7" />
      <!-- barrel walls -->
      <g data-walls>
        <rect x="96" y="20" width="10" height="170" data-wall />
        <rect x="294" y="20" width="10" height="170" data-wall />
        {baffles.map((y) => (<><rect x="106" y={y} width="16" height="4" data-wall /><rect x="278" y={y} width="16" height="4" data-wall /></>))}
      </g>
      <!-- signal rays -->
      <g stroke="#c8f6ff" stroke-opacity=".55" fill="none">
        <line x1="170" y1="19" x2="196" y2="200" /><line x1="200" y1="19" x2="200" y2="200" /><line x1="230" y1="19" x2="204" y2="200" />
      </g>
      <!-- stray rays: path to the wall, then either a bounce to the eye or absorption -->
      <g data-stray fill="none" stroke="#ffb347" stroke-width="1.2">
        <polyline points="150,19 106,92" /><polyline data-bounce points="106,92 190,202" />
        <polyline points="250,19 294,60" /><polyline data-bounce points="294,60 212,202" />
        <polyline points="135,19 106,140" /><polyline data-bounce points="106,140 196,203" />
        <polyline points="265,19 294,128" /><polyline data-bounce points="294,128 206,203" />
      </g>
      <g data-absorb fill="#ffb347">
        <circle cx="106" cy="92" r="3" /><circle cx="294" cy="60" r="3" /><circle cx="106" cy="140" r="3" /><circle cx="294" cy="128" r="3" />
      </g>
      <text x="100" y="214" font-size="9" fill="#6a7fa8" data-wall-label>Kurocoat lining + baffles</text>
    </svg>
    <div class="wo__panel">
      <h4>Black floor at the eye</h4>
      <div class="glare__swatch" data-swatch><span>Black</span></div>
      <p class="wo__note" data-caption>Stray light is absorbed in the barrel. Black stays black.</p>
    </div>
  </div>
  <div class="wo__controls">
    <div class="wo__seg" role="group" aria-label="Barrel lining">
      <button type="button" data-set="bare" aria-pressed="false">Bare barrel</button>
      <button type="button" data-set="kuro" aria-pressed="true">Kurocoat-lined</button>
    </div>
  </div>
  <p class="wo__note">Glare control feeds the black-level budget: veiling glare would otherwise lift the black floor.</p>
</figure>

<style>
  .glare [data-wall] { fill: #05060a; stroke: #2a3860; transition: fill .4s; }
  .glare[data-mode='bare'] [data-wall] { fill: #8a95ab; stroke: #c8d2e6; }
  .glare [data-bounce] { opacity: 0; transition: opacity .4s; stroke-dasharray: 5 5; }
  .glare[data-mode='bare'] [data-bounce] { opacity: .9; }
  .glare [data-absorb] circle { opacity: .9; transition: opacity .4s; }
  .glare[data-mode='bare'] [data-absorb] circle { opacity: 0; }
  :global(html[data-vfx-tier='full']) .glare[data-mode='bare'] [data-bounce] { animation: wo-flow 1.4s linear infinite; }
  .glare__swatch { height: 92px; border-radius: 8px; background: #000; border: 1px solid #1a2240; display: grid; place-items: center; transition: background .5s; }
  .glare__swatch span { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #3a4a6a; }
  .glare[data-mode='bare'] .glare__swatch { background: #1c2028; }
  :global(html[data-vfx-tier='static']) .glare * { transition: none !important; }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-glare]')) {
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-set]')];
    const cap = root.querySelector<HTMLElement>('[data-caption]')!;
    const lab = root.querySelector<SVGTextElement>('[data-wall-label]')!;
    const sw = root.querySelector<HTMLElement>('[data-swatch] span')!;
    btns.forEach((b) => b.addEventListener('click', () => {
      const m = b.dataset.set!;
      root.dataset.mode = m;
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const bare = m === 'bare';
      cap.textContent = bare ? 'Stray light bounces off the walls into your eye and lifts the black floor.' : 'Stray light is absorbed in the barrel. Black stays black.';
      lab.textContent = bare ? 'bare barrel walls' : 'Kurocoat lining + baffles';
      sw.textContent = bare ? 'Lifted black' : 'Black';
    }));
  }
</script>
