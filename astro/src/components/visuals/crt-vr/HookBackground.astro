---
/**
 * CRT-VR · Act 1 scroll background ("act-01/background").
 *
 * A CRT power-on bloom (dot → line → raster) that opens into a wide,
 * wraparound VR field of view (40° → 180°+) as you scroll, then settles into a
 * dim phosphor field so the copy above it stays readable.
 *
 * Drop it anywhere inside Act 1: on mount it moves itself to be the first child
 * of the closest `.act`, and starts after the hero animatic if one is present.
 * The VFX thread can later mount it from its ActBackground system unchanged.
 *
 * Tiers: full (canvas, sprite glow, idle shimmer + refresh sweep), reduced
 * (canvas, fewer cells, redraw on scroll only), static (CSS-only still frame).
 */
import './tokens.css';
import type { VfxSlotProps } from '../../../lib/motion/types';

interface Props extends Partial<VfxSlotProps> {
  /** Screens of scroll the power-on + FOV opening takes. */
  openLength?: number;
}
const { tier = 'full', openLength = 2.4 } = Astro.props;
---

<div class:list={['crtvr', 'hook-bg', { 'is-static': tier === 'static' }]} data-hook-bg data-open={openLength} aria-hidden="true">
  <div class="vp">
    <canvas></canvas>
    <div class="still">
      <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
        <defs>
          <radialGradient id="hookbg-still" cx="50%" cy="45%" r="60%">
            <stop offset="0" stop-color="#00ff99" stop-opacity=".16" />
            <stop offset=".6" stop-color="#00ff99" stop-opacity=".04" />
            <stop offset="1" stop-color="#00ff99" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect width="1600" height="900" fill="url(#hookbg-still)" />
        <g fill="none" stroke="#00ff99" stroke-opacity=".12">
          <path d="M-80,150 Q800,40 1680,150" /><path d="M-80,750 Q800,860 1680,750" />
          <path d="M-80,300 Q800,230 1680,300" /><path d="M-80,600 Q800,670 1680,600" />
          <path d="M-80,450 L1680,450" />
        </g>
      </svg>
    </div>
    <div class="scan"></div>
  </div>
</div>

<style>
  .hook-bg {
    position: absolute; left: 0; right: 0; bottom: 0; top: var(--hb-top, 0px);
    z-index: -1; pointer-events: none; overflow: clip;
  }
  .vp { position: sticky; top: 0; height: 100vh; height: 100svh; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; max-width: none; }
  .still { position: absolute; inset: 0; display: none; }
  .still svg { width: 100%; height: 100%; max-width: none; }
  .scan {
    position: absolute; inset: 0;
    background: repeating-linear-gradient(to bottom, rgba(0,0,0,.25) 0 1px, transparent 1px 3px);
    opacity: .5;
  }
  .hook-bg.is-static canvas { display: none; }
  .hook-bg.is-static .still { display: block; }
</style>

<script>
  import { onTier, type VfxTier } from './lib/tier';
  import { clamp, seg, easeOut, easeInOut, expoOut, lerp } from './lib/scrub';

  const PRIMARY = '0,255,153';

  function makeSprite(size: number, rgb: string) {
    const c = document.createElement('canvas');
    c.width = c.height = size;
    const g = c.getContext('2d')!;
    const grd = g.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
    grd.addColorStop(0, `rgba(235,255,244,1)`);
    grd.addColorStop(0.18, `rgba(${rgb},.9)`);
    grd.addColorStop(0.5, `rgba(${rgb},.18)`);
    grd.addColorStop(1, `rgba(${rgb},0)`);
    g.fillStyle = grd; g.fillRect(0, 0, size, size);
    return c;
  }

  function init(root: HTMLElement) {
    // Relocate into the act so we can span it.
    const act = root.closest('.act') as HTMLElement | null;
    if (act && root.parentElement !== act) act.prepend(root);
    const host = act ?? (root.parentElement as HTMLElement);
    if (getComputedStyle(host).position === 'static') host.style.position = 'relative';

    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d', { alpha: true })!;
    const openLen = parseFloat(root.dataset.open || '2.4');
    const mono = getComputedStyle(root).getPropertyValue('--crtvr-font-mono').trim() || 'monospace';
    const sprite = makeSprite(32, PRIMARY);

    let tier: VfxTier = 'full';
    let w = 0, h = 0, dpr = 1;
    let p = 0, shown = 0, visible = false, idleRaf = 0, scrollRaf = 0, last = 0;

    const heroOffset = () => {
      const hero = host.querySelector('[data-hero-anim]') as HTMLElement | null;
      if (!hero) return 0;
      return hero.getBoundingClientRect().bottom - host.getBoundingClientRect().top;
    };
    const layout = () => {
      root.style.setProperty('--hb-top', `${Math.max(0, heroOffset())}px`);
      dpr = Math.min(window.devicePixelRatio || 1, tier === 'full' ? 1.5 : 1);
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    const measure = () => {
      const top = root.getBoundingClientRect().top;
      const vh = window.innerHeight;
      return clamp((vh - top) / (vh * openLen));
    };

    function draw(pr: number, time: number) {
      ctx.clearRect(0, 0, w, h);
      const cx = w / 2, cy = h * 0.46;
      const full = tier === 'full';

      // ── 1 · power-on: dot → line → raster bloom
      const pw = seg(pr, 0, 0.32);
      const dotP = seg(pw, 0, 0.2), lineP = seg(pw, 0.2, 0.48), openP = seg(pw, 0.48, 1);
      const fv = easeInOut(seg(pr, 0.28, 0.78));            // FOV opening
      const settle = seg(pr, 0.7, 1);
      const master = lerp(1, 0.55, settle);

      ctx.globalCompositeOperation = 'lighter';
      if (dotP > 0 && lineP < 1) {
        const r = 6 + 40 * easeOut(dotP);
        ctx.globalAlpha = dotP * (1 - lineP);
        ctx.drawImage(sprite, cx - r, cy - r, r * 2, r * 2);
      }
      if (lineP > 0) {
        const rw = w * 0.7 * Math.max(0.004, easeOut(lineP)) * lerp(1, 1.6, fv);
        const rh = h * 0.5 * Math.max(0.006, expoOut(openP)) * lerp(1, 1.5, fv);
        const flash = Math.sin(Math.PI * openP) * 0.9 + lineP * (1 - openP) * 0.6;
        const rasterA = (0.18 + flash) * (1 - fv * 0.85) * master;
        // raster body: a soft, rounded CRT raster (no hard rectangle edges)
        ctx.save();
        ctx.translate(cx, cy);
        ctx.scale(Math.max(1, rw / 2), Math.max(1, rh / 2));
        const g = ctx.createRadialGradient(0, 0, 0, 0, 0, 1);
        g.addColorStop(0, `rgba(235,255,244,${clamp(rasterA)})`);
        g.addColorStop(0.45, `rgba(${PRIMARY},${clamp(rasterA * 0.5)})`);
        g.addColorStop(0.8, `rgba(${PRIMARY},${clamp(rasterA * 0.12)})`);
        g.addColorStop(1, `rgba(${PRIMARY},0)`);
        ctx.globalAlpha = 1;
        ctx.fillStyle = g;
        ctx.fillRect(-1, -1, 2, 2);
        ctx.restore();
        // the bright line itself while it is still a line
        if (openP < 1) {
          ctx.globalAlpha = (1 - openP) * lineP;
          ctx.drawImage(sprite, cx - rw / 2, cy - 10, rw, 20);
        }
        // bloom halo
        const halo = (0.25 + 0.75 * Math.sin(Math.PI * openP)) * (1 - fv * 0.6) * master;
        const hg = ctx.createRadialGradient(cx, cy, 0, cx, cy, Math.max(w, h) * 0.6);
        hg.addColorStop(0, `rgba(${PRIMARY},${0.22 * halo})`);
        hg.addColorStop(1, `rgba(${PRIMARY},0)`);
        ctx.fillStyle = hg; ctx.globalAlpha = 1;
        ctx.fillRect(0, 0, w, h);
      }

      // ── 2 · wraparound field: a hex lattice on a sphere, opening 40° → 200°
      if (fv > 0) {
        const fovDeg = lerp(40, 200, fv);
        const cols = full ? 72 : 40, rows = full ? 26 : 16;
        const halfX = w * 0.58, halfY = h * 0.44;
        const gazeU = full ? 0.35 * Math.sin(time * 0.00023) : 0;
        const gazeV = full ? 0.18 * Math.sin(time * 0.00031 + 1) : 0;
        const sweepV = full ? ((time * 0.00012) % 1) * 2.4 - 1.2 : 9; // slow refresh sweep
        for (let j = 0; j <= rows; j++) {
          const v = (j / rows) * 2 - 1;
          for (let i = 0; i <= cols; i++) {
            const uRaw = ((i + (j % 2) * 0.5) / cols) * 2 - 1; // hex offset
            const aDeg = uRaw * (fovDeg / 2);
            const u = aDeg / 100;                               // ±1 at 200°
            if (Math.abs(u) > 1) continue;
            const ang = u * Math.PI / 2;
            const x = cx + halfX * Math.sin(ang);
            const y = cy + halfY * v * (1 - 0.2 * u * u);
            const fore = Math.cos(ang) * 0.75 + 0.25;
            const du = u - gazeU, dv = v - gazeV;
            const core = Math.exp(-(du * du + dv * dv) / 0.02);
            const sweep = Math.exp(-((v - sweepV) ** 2) / 0.004);
            const twinkle = full ? 0.5 + 0.5 * Math.sin(time * 0.002 + i * 1.7 + j * 2.3) : 0.5;
            const edge = 1 - Math.pow(Math.abs(v), 6);
            const a = (0.1 + 0.08 * twinkle + 0.7 * core + 0.35 * sweep) * fv * edge * master;
            const s = (2 + 5 * core + 2 * sweep) * fore;
            ctx.globalAlpha = clamp(a);
            ctx.drawImage(sprite, x - s * 2, y - s * 2, s * 4, s * 4);
          }
        }

        // top/bottom boundary of the field: the old screen edge, now curved around you
        ctx.globalCompositeOperation = 'source-over';
        ctx.strokeStyle = `rgba(${PRIMARY},${0.28 * fv * master})`;
        ctx.lineWidth = 1;
        for (const sgn of [-1, 1]) {
          ctx.beginPath();
          for (let k = 0; k <= 80; k++) {
            const u = ((k / 80) * 2 - 1) * (fovDeg / 200);
            const x = cx + halfX * Math.sin(u * Math.PI / 2);
            const y = cy + sgn * halfY * 1.04 * (1 - 0.2 * u * u);
            k ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
          }
          ctx.stroke();
        }

        // degree scale + readout
        const sy = cy - halfY * 1.04 - 18;
        ctx.fillStyle = `rgba(106,127,168,${0.9 * fv})`;
        ctx.font = `11px ${mono}`;
        ctx.textAlign = 'center';
        for (let dgr = -100; dgr <= 100; dgr += 10) {
          if (Math.abs(dgr) > fovDeg / 2) continue;
          const u = dgr / 100;
          const x = cx + halfX * Math.sin(u * Math.PI / 2);
          const yTop = sy + 0.2 * halfY * u * u;
          const major = dgr % 30 === 0;
          ctx.globalAlpha = fv * (major ? 0.9 : 0.45);
          ctx.fillRect(x - 0.5, yTop, 1, major ? 10 : 5);
          if (major && h > 520) ctx.fillText(`${dgr > 0 ? '+' : ''}${dgr}°`, x, yTop - 6);
        }
        ctx.globalAlpha = fv;
        ctx.fillStyle = `rgba(${PRIMARY},1)`;
        ctx.font = `12px ${mono}`;
        const fovTxt = fovDeg >= 180 ? 'FIELD OF VIEW  180°+' : `FIELD OF VIEW  ${Math.round(fovDeg)}°`;
        ctx.fillText(fovTxt.split('').join(String.fromCharCode(8202)), cx, cy + halfY * 1.04 + 34);
      }
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
    }

    const frame = (now: number) => {
      scrollRaf = 0;
      shown += (p - shown) * (tier === 'full' ? 0.16 : 0.35);
      if (Math.abs(p - shown) < 0.0005) shown = p;
      draw(shown, now);
      if (shown !== p) scrollRaf = requestAnimationFrame(frame);
    };
    const kick = () => {
      p = measure();
      if (!scrollRaf && visible && tier !== 'static') scrollRaf = requestAnimationFrame(frame);
    };
    const idle = (now: number) => {
      idleRaf = requestAnimationFrame(idle);
      if (now - last < 33 || scrollRaf) return; // ~30 fps shimmer
      last = now;
      draw(shown, now);
    };
    const startIdle = () => { if (!idleRaf && tier === 'full' && visible) idleRaf = requestAnimationFrame(idle); };
    const stopIdle = () => { if (idleRaf) cancelAnimationFrame(idleRaf); idleRaf = 0; };

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) { kick(); startIdle(); } else stopIdle();
    }).observe(root);
    window.addEventListener('scroll', kick, { passive: true });
    window.addEventListener('resize', () => { layout(); kick(); });
    // hero height can settle after fonts/images; re-measure once things load
    window.addEventListener('load', () => { layout(); kick(); });

    onTier((t) => {
      tier = t;
      root.classList.toggle('is-static', t === 'static');
      stopIdle();
      layout();
      if (t === 'static') return;
      kick(); startIdle();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-hook-bg]').forEach(init);
</script>
