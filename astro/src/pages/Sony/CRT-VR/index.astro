---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ActRail from '../../../components/kit/ActRail.astro';
import {
  ActWrapper, ActTitle, Section, Slot, StatCard, Badge, ComparisonTable, CertificationWall, Footnote,
} from '../../../components/kit';
import HeroAnimatic from '../../../components/visuals/crt-vr/HeroAnimatic.astro';
import HookBackground from '../../../components/visuals/crt-vr/HookBackground.astro';
import RevealStats from '../../../components/visuals/crt-vr/RevealStats.astro';
import GlobalVfx from '../../../components/vfx/GlobalVfx.astro';
import CrtVrInteractive from '../../../components/interactives/crt-vr/CrtVrInteractive.astro';
import { BUILT_INTERACTIVES } from '../../../components/interactives/crt-vr';
import { acts } from '../../../data/crt-vr';
import { comparisonHeads, comparisonRows, openQuestions, liveFootnotes, specGroups } from '../../../data/crt-vr-proof';
import SpecTable from '../../../components/kit/SpecTable.astro';
// Act 4 · RGBMCY interactives and visuals
import GamutExplorer from '../../../components/interactives/crt-vr/GamutExplorer';
import HexZoom from '../../../components/interactives/crt-vr/HexZoom';
import SixBeamConvergence from '../../../components/interactives/crt-vr/SixBeamConvergence';
import CoverageCalc from '../../../components/interactives/crt-vr/CoverageCalc';
import PuretonePicker from '../../../components/interactives/crt-vr/PuretonePicker';
import GamutInnovations from '../../../components/visuals/crt-vr/GamutInnovations.astro';
import CertBadgeWall from '../../../components/visuals/crt-vr/CertBadgeWall.astro';
import CrtvrSlot from '../../../components/interactives/crt-vr/CrtvrSlot.astro';
import ExplodedTube from '../../../components/interactives/crt-vr/ExplodedTube.astro';
import GunShootout from '../../../components/interactives/crt-vr/GunShootout.astro';
import BeamFunnel from '../../../components/interactives/crt-vr/BeamFunnel.astro';
import HexaEmission from '../../../components/interactives/crt-vr/HexaEmission.astro';
import HexaSensors from '../../../components/interactives/crt-vr/HexaSensors.astro';
import HexaFeatures from '../../../components/interactives/crt-vr/HexaFeatures.astro';
import PitchCalc from '../../../components/interactives/crt-vr/PitchCalc.astro';
import BlueprintBackground from '../../../components/visuals/crt-vr/BlueprintBackground.astro';
import PupilSwim from '../../../components/visuals/crt-vr/PupilSwim.astro';
import GlareControl from '../../../components/visuals/crt-vr/GlareControl.astro';
import FlatVsCone from '../../../components/interactives/crt-vr/FlatVsCone';
import RayTracer from '../../../components/interactives/crt-vr/RayTracer';
import RotateEye from '../../../components/interactives/crt-vr/RotateEye';
import TierCompare from '../../../components/interactives/crt-vr/TierCompare';
import ExplodedRelay from '../../../components/interactives/crt-vr/ExplodedRelay';
import FringeToggle from '../../../components/interactives/crt-vr/FringeToggle';

// Act 8 visuals and islands that replace their <Slot>.
const act8Visuals = new Set(['pupil-swim', 'glare-control']);
const act8Islands = new Set(['flat-vs-cone', 'rotate-eye', 'tier-compare', 'exploded-relay', 'fringe-toggle']);

const placeholder = '[copy pending]';
/* Act 7 · The Machine interactives (slot id → component). Hexa-Index mounts emission, sensors and features. */
const act7: Record<string, any> = {
  'exploded-tube': ExplodedTube, 'gun-shootout': GunShootout, 'beam-funnel': BeamFunnel,
  'hexa-emission': HexaEmission, 'pitch-calc': PitchCalc,
};
---
<BaseLayout
  title="SONY CRT-VR — 2nd® Gen preview"
  description="Preview scaffold for the 2nd® Gen CRT-VR page."
>
  <div class="page-chrome">
    <p class="eyebrow">NewGen × Sony · 2nd® Gen preview</p>
  </div>
  <GlobalVfx />
  <ActRail />
  <main>
    {acts.map((act) => (
      <ActWrapper id={act.id} number={act.number} transition={act.transition} title={act.title}>
        {act.number === 7 && <BlueprintBackground slot="background" tier="full" reducedMotion={false} />}
        <ActTitle number={act.number} title={act.title} subtitle={act.tagline} />
        {act.sections.map((s) => (
          <Section id={s.id} title={s.headline ?? s.title} eyebrow={s.eyebrow}>
            {s.kind === 'hero' && <Badge kind="trl" label="TRL 2–3" />}
            {s.body ? s.body.map((p) => <p>{p}</p>) : s.kind !== 'stats' && s.kind !== 'badges' && s.kind !== 'comparison' && s.kind !== 'specs' && s.kind !== 'honesty' && <p>{placeholder}</p>}

            {s.kind === 'stats' && s.id === 'the-reveal' && act.number === 1 && (
              <RevealStats tier="full" reducedMotion={false} items={(s.items ?? []).map((i) => ({ value: i.value ?? '', unit: i.unit, label: i.label, color: i.color }))} />
            )}
            {s.kind === 'stats' && !(s.id === 'the-reveal' && act.number === 1) && (
              <div class="stat-grid">
                {(s.items ?? []).map((i) => <StatCard label={i.label} value={i.value} unit={i.unit} />)}
              </div>
            )}
            {s.kind === 'badges' && <CertBadgeWall tier="full" reducedMotion={false} items={s.items ?? []} />}
            {s.kind === 'comparison' && !s.interactive && (
              <ComparisonTable caption="CRT-VR vs. everything" columns={comparisonHeads} rows={comparisonRows} />
            )}
            {s.kind === 'specs' && specGroups.map((g) => <SpecTable caption={g.name} rows={g.rows} />)}
            {s.kind === 'honesty' && (
              <>
                <ol class="open-questions">
                  {openQuestions.map((q, i) => (
                    <li><span class="eyebrow">{q.tier}</span> <span>№{i + 1}</span><p>{q.body}</p></li>
                  ))}
                </ol>
                {liveFootnotes.map((f, i) => <Footnote n={i + 1}>{f}</Footnote>)}
              </>
            )}

            {s.footnote && <Footnote n="†">{s.footnote}</Footnote>}
            {s.visual === 'hero-animatic' && <HeroAnimatic tier="full" reducedMotion={false} />}
            {s.visual === 'hero-animatic' && <HookBackground tier="full" reducedMotion={false} variant="hook" />}
            {s.visual === 'pupil-swim' && <PupilSwim tier="full" reducedMotion={false} />}
            {s.visual === 'glare-control' && <GlareControl tier="full" reducedMotion={false} />}
            {s.visual && s.visual !== 'hero-animatic' && !act8Visuals.has(s.visual) && <CrtvrSlot id={s.visual} kind="visual" />}
            {s.interactive === 'flat-vs-cone' && (
              <>
                <FlatVsCone client:visible tier="full" reducedMotion={false} />
                <RayTracer client:visible tier="full" reducedMotion={false} />
              </>
            )}
            {s.interactive === 'rotate-eye' && <RotateEye client:visible tier="full" reducedMotion={false} />}
            {s.interactive === 'tier-compare' && <TierCompare client:visible tier="full" reducedMotion={false} />}
            {s.interactive === 'exploded-relay' && <ExplodedRelay client:visible tier="full" reducedMotion={false} />}
            {s.interactive === 'fringe-toggle' && <FringeToggle client:visible tier="full" reducedMotion={false} />}
            {s.interactive === 'gamut-explorer' && <GamutExplorer client:visible tier="full" reducedMotion={false} />}
            {s.interactive === 'hex-zoom' && <HexZoom client:visible tier="full" reducedMotion={false} />}
            {s.interactive === 'six-beam-convergence' && <SixBeamConvergence client:visible tier="full" reducedMotion={false} />}
            {s.interactive === 'coverage-calc' && <CoverageCalc client:visible tier="full" reducedMotion={false} />}
            {s.interactive === 'puretone-picker' && <PuretonePicker client:visible tier="full" reducedMotion={false} />}
            {act.number === 4 && s.id === 'gamut-innovations' && <GamutInnovations tier="full" reducedMotion={false} />}
            {s.interactive && BUILT_INTERACTIVES.has(s.interactive) && <CrtVrInteractive id={s.interactive} />}
            {s.interactive && act7[s.interactive] && (() => { const C = act7[s.interactive!]; return <C tier="full" reducedMotion={false} />; })()}
            {s.id === 'hexa-index' && <HexaSensors tier="full" reducedMotion={false} />}
            {s.id === 'hexa-index' && <HexaFeatures tier="full" reducedMotion={false} />}
            {s.interactive && !BUILT_INTERACTIVES.has(s.interactive) && !act8Islands.has(s.interactive) && !act7[s.interactive] && !['gamut-explorer', 'hex-zoom', 'six-beam-convergence', 'coverage-calc', 'puretone-picker'].includes(s.interactive) && <CrtvrSlot id={s.interactive} kind="interactive" />}
          </Section>
        ))}
      </ActWrapper>
    ))}
  </main>
</BaseLayout>
<style>
  .page-chrome { position: sticky; top: 0; z-index: 10; padding: var(--s-2) var(--gutter); background: color-mix(in srgb, var(--bg) 85%, transparent); }
  .stat-grid { display: grid; gap: var(--s-2); grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); margin: var(--s-3) 0; }
  .open-questions { list-style: none; display: grid; gap: var(--s-2); margin: var(--s-3) 0; }
  main { padding-right: 0; }
</style>
