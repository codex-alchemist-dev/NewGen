---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ActRail from '../../../components/kit/ActRail.astro';
import {
  ActWrapper, ActTitle, Section, Slot, StatCard, Badge, SpecTable, ComparisonTable, CertificationWall, Footnote, Callout,
} from '../../../components/kit';
import { acts } from '../../../data/crt-vr';
import HeroAnimatic from '../../../components/visuals/crt-vr/HeroAnimatic.astro';
import HookBackground from '../../../components/visuals/crt-vr/HookBackground.astro';
import RevealStats from '../../../components/visuals/crt-vr/RevealStats.astro';
import GlobalVfx from '../../../components/vfx/GlobalVfx.astro';
import PupilSwim from '../../../components/visuals/crt-vr/PupilSwim.astro';
import GlareControl from '../../../components/visuals/crt-vr/GlareControl.astro';
import FlatVsCone from '../../../components/interactives/crt-vr/FlatVsCone';
import RayTracer from '../../../components/interactives/crt-vr/RayTracer';
import RotateEye from '../../../components/interactives/crt-vr/RotateEye';
import TierCompare from '../../../components/interactives/crt-vr/TierCompare';
import ExplodedRelay from '../../../components/interactives/crt-vr/ExplodedRelay';
import FringeToggle from '../../../components/interactives/crt-vr/FringeToggle';

// Act 8 visuals and islands that replace their <Slot>.
const act8Visuals = new Set(['pupil-swim', 'glare-control']);
const act8Islands = new Set(['flat-vs-cone', 'rotate-eye', 'tier-compare', 'fringe-toggle']);

const placeholder = '[copy pending]';
---
<BaseLayout
  title="SONY CRT-VR — 2nd® Gen preview"
  description="Preview scaffold for the 2nd® Gen CRT-VR page. Placeholder copy."
>
  <div class="page-chrome">
    <p class="eyebrow">NewGen × Sony · 2nd® Gen preview · placeholder copy</p>
  </div>
  <GlobalVfx />
  <ActRail />
  <main>
    {acts.map((act) => (
      <ActWrapper id={act.id} number={act.number} transition={act.transition} title={act.title}>
        <ActTitle number={act.number} title={act.title} subtitle={act.tagline} />
        {act.sections.map((s) => (
          <Section id={s.id} title={s.title}>
            {s.kind === 'hero' && (
              <>
                <Badge kind="trl" label="TRL 2–3" />
                <p>{placeholder}</p>
              </>
            )}
            {s.kind !== 'stats' && s.kind !== 'badges' && s.kind !== 'comparison' && s.kind !== 'specs' && (
              <p>{placeholder}</p>
            )}
            {s.kind === 'stats' && s.id === 'the-reveal' && act.number === 1 && <RevealStats tier="full" reducedMotion={false} />}
            {s.kind === 'stats' && !(s.id === 'the-reveal' && act.number === 1) && (
              <div class="stat-grid">
                {(s.items ?? []).map((i) => <StatCard label={i.label} />)}
              </div>
            )}
            {s.kind === 'badges' && (
              <CertificationWall items={s.items ?? []} footnote={s.footnote} />
            )}
            {s.kind === 'comparison' && (
              <ComparisonTable caption="Versus" columns={s.columns ?? []} rows={(s.items ?? []).map((i) => ({ label: i.label, cells: i.cells ?? [] }))} />
            )}
            {s.kind === 'specs' && <SpecTable caption="Full specs" rows={[]} />}
            {s.visual === 'hero-animatic' && <HeroAnimatic tier="full" reducedMotion={false} />}
            {/* Act 1 background (act-01/background). It mounts itself into the act; the VFX thread can move it into ActBackground. */}
            {s.visual === 'hero-animatic' && <HookBackground tier="full" reducedMotion={false} variant="hook" />}
            {s.visual === 'pupil-swim' && <PupilSwim tier="full" reducedMotion={false} />}
            {s.visual === 'glare-control' && <GlareControl tier="full" reducedMotion={false} />}
            {s.visual && s.visual !== 'hero-animatic' && !act8Visuals.has(s.visual) && <Slot id={s.visual} kind="visual" />}
            {s.interactive === 'flat-vs-cone' && (
              <>
                <FlatVsCone client:visible tier="full" reducedMotion={false} />
                <RayTracer client:visible tier="full" reducedMotion={false} />
              </>
            )}
            {s.interactive === 'rotate-eye' && <RotateEye client:visible tier="full" reducedMotion={false} />}
            {s.interactive === 'tier-compare' && (
              <>
                <TierCompare client:visible tier="full" reducedMotion={false} />
                <ExplodedRelay client:visible tier="full" reducedMotion={false} />
              </>
            )}
            {s.interactive === 'fringe-toggle' && <FringeToggle client:visible tier="full" reducedMotion={false} />}
            {s.interactive && !act8Islands.has(s.interactive) && <Slot id={s.interactive} kind="interactive" />}
          </Section>
        ))}
      </ActWrapper>
    ))}
  </main>
</BaseLayout>
<style>
  .page-chrome { position: sticky; top: 0; z-index: 10; padding: var(--s-2) var(--gutter); background: color-mix(in srgb, var(--bg) 85%, transparent); }
  .stat-grid { display: grid; gap: var(--s-2); grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); margin: var(--s-3) 0; }
  main { padding-right: 0; }
</style>
